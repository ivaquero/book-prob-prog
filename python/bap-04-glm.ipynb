            "source": [
                "## Poisson regression"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "15721f1e",
            "metadata": {},
            "source": [
                "### The Zero-Inflated Poisson model"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 38,
            "id": "LJZf",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "Text(0, 0.5, 'f(x)')"
                        ]
                    },
                    "execution_count": 38,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 720x480 with 1 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "mu_params = [0.5, 1.5, 3, 8]\n",
                "x = np.arange(0, max(mu_params) * 3)\n",
                "for mu in mu_params:\n",
                "    y = stats.poisson(mu).pmf(x)\n",
                "    plt.plot(x, y, \"o-\", label=f\"μ = {mu:3.1f}\")\n",
                "plt.legend()\n",
                "plt.xlabel(\"x\")\n",
                "plt.ylabel(\"f(x)\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 39,
            "id": "jxvo",
            "metadata": {},
            "outputs": [],
            "source": [
                "n = 100\n",
                "θ_real = 2.5\n",
                "ψ = 0.1\n",
                "counts = np.array([\n",
                "    (np.random.random() > 1 - ψ) * np.random.poisson(θ_real) for _ in range(n)\n",
                "])"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 40,
            "id": "mWxS",
            "metadata": {},
            "outputs": [
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "Initializing NUTS using jitter+adapt_diag...\n",
                        "Multiprocess sampling (4 chains in 4 jobs)\n",
                        "NUTS: [ψ, θ]\n"
                    ]
                },
                {
                    "data": {
                        "application/vnd.jupyter.widget-view+json": {
                            "model_id": "87f06550a3ea408e9ae0bef738773215",
