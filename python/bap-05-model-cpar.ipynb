            "source": [
                "traces = []\n",
                "waics = []\n",
                "for coin, head in [(30, 9), (300, 90)]:\n",
                "    y_d1 = np.repeat([0, 1], [coins - heads, heads])\n",
                "    for prior in [(4, 8), (8, 4)]:\n",
                "        path_ = f\"../../book-prob-tmp/bap-05-waic-{coin}-{head}-{prior}.nc\"\n",
                "        with pm.Model() as model:\n",
                "            θ_ = pm.Beta(\"θ\", *prior)\n",
                "            _ = pm.Bernoulli(\"y\", θ_, observed=y_d1)\n",
                "            if os.path.isfile(path_):\n",
                "                trace = az.from_netcdf(path_)\n",
                "            else:\n",
                "                trace = pm.sample(2000, idata_kwargs={\"log_likelihood\": True})\n",
                "                trace.to_netcdf(path_)\n",
                "            traces.append(trace)\n",
                "            waics.append(az.waic(trace, scale=\"deviance\"))"
            ]
        },
