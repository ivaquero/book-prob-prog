        {
            "cell_type": "markdown",
            "id": "196bf1a1",
            "metadata": {},
            "source": [
                "## How to choose K"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 12,
            "id": "nWHF",
            "metadata": {},
            "outputs": [],
            "source": [
                "clusters_2 = [3, 4, 5, 6]\n",
                "models = []\n",
                "traces = []\n",
                "for cluster_2 in clusters_2:\n",
                "    with pm.Model() as model:\n",
                "        p_k = pm.Dirichlet(\"p\", a=np.ones(cluster_2))\n",
                "        means_k = pm.Normal(\n",
                "            \"means\",\n",
                "            mu=np.linspace(cs[\"exp\"].min(), cs[\"exp\"].max(), cluster_2),\n",
                "            sigma=10,\n",
                "            shape=cluster_2,\n",
                "            transform=pm.distributions.transforms.ordered,\n",
                "        )\n",
                "        sd_k = pm.HalfNormal(\"sd\", sigma=10)\n",
                "        y_k = pm.NormalMixture(\"y\", w=p_k, mu=means_k, sigma=sd_k, observed=cs[\"exp\"])\n",
                "        path_gmm = f\"../../book-prob-tmp/bap-07-gmm-clus-{cluster_2}.nc\"\n",
                "        if os.path.isfile(path_gmm):\n",
                "            trace = az.from_netcdf(path_gmm)\n",
                "        else:\n",
                "            trace = pm.sample(\n",
