            "source": [
                "posterior = idata_lg.posterior\n",
                "theta = posterior[\"θ\"]\n",
                "theta_m = theta.mean((\"chain\", \"draw\"))\n",
                "bd_m = posterior[\"bd\"].mean((\"chain\", \"draw\"))\n",
                "bd_hdi = az.hdi(posterior[\"bd\"])[\"bd\"]\n",
                "idx_lr = np.argsort(x_c)\n",
                "\n",
                "_, ax1 = plt.subplots()\n",
                "ax1.scatter(x_c, np.random.normal(y_0, 0.02), marker=\".\", color=[f\"C{x}\" for x in y_0])\n",
                "ax1.vlines(bd_m, 0, 1, color=\"black\", zorder=0)\n",
                "ax1.fill_betweenx([0, 1], bd_hdi[0], bd_hdi[1], color=\"green\", alpha=0.6, lw=0)\n",
                "ax1.plot(x_c[idx_lr], theta_m[idx_lr], color=\"orange\", lw=2)\n",
                "az.plot_hdi(x_c, theta, color=\"blue\", ax=ax1, fill_kwargs={\"lw\": 0})\n",
                "ax1.set(xlabel=\"sepal_length\", ylabel=\"θ\")"
            ]
        },
