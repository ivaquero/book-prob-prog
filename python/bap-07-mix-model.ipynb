            "outputs": [],
            "source": [
                "def stick_breaking_truncated(α, H, K):\n",
                "    βs = stats.beta.rvs(1, α, size=K)\n",
                "    weighs = np.empty(K)\n",
                "    weighs = βs * np.concatenate(([1.0], np.cumprod(1 - βs[:-1])))\n",
                "    locs = H.rvs(size=K)\n",
                "    return (locs, weighs)\n",
                "\n",
                "\n",
                "K = 500\n",
                "H = stats.norm\n",
                "αs = [1, 10, 100, 1000]\n",
                "_, axes2 = plt.subplots(1, 4, sharex=True, figsize=(12, 3))\n",
                "for α_st, ax_nf in zip(αs, axes2.flatten()):\n",
                "    locs, weighs = stick_breaking_truncated(α_st, H, K)\n",
                "    ax_nf.vlines(locs, 0, weighs, color=\"C0\")\n",
                "    ax_nf.set(title=f\"α = {α_st}\")"
            ]
        },
        {
