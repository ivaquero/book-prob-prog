            "id": "4b628d20",
            "metadata": {},
            "source": [
                "### Covariance functions and kernels"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 3,
            "id": "bkHC",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "<matplotlib.legend.Legend at 0x15d6100e0>"
                        ]
                    },
                    "execution_count": 3,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
