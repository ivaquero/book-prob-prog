            "source": [
                "t4 = pd.DataFrame({\n",
                "    \"Possible composition\": \"[\"\n",
                "    + t[\"d1\"]\n",
                "    + \" \"\n",
                "    + t[\"d2\"]\n",
                "    + \" \"\n",
                "    + t[\"d3\"]\n",
                "    + \" \"\n",
                "    + t[\"d4\"]\n",
                "    + \"]\",\n",
                "    \"*p*\": t[\"blue1\"] / 4,\n",
                "    \"Ways to produce data\": ways,\n",
                "    \"Plausibility\": ways / ways.sum(),\n",
                "})\n",
                "\n",
                "t4.style.set_properties(**{\n",
                "    \"text-align\": \"center\",\n",
