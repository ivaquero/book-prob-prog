            "source": [
                "_, axes = plt.subplots(2, 2, figsize=(10, 5), sharex=True, sharey=True)\n",
                "az.plot_ppc(\n",
                "    idata_cg,\n",
                "    num_pp_samples=100,\n",
                "    colors=[\"C1\", \"C0\", \"C0\"],\n",
                "    coords={\"days_flat\": [categories]},\n",
                "    flatten=[],\n",
                "    ax=axes,\n",
                ")"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "a7b9401d",
            "metadata": {},
            "source": [
                "## Posterior analysis of mean differences"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 9,
            "id": "iLit",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 3600x2400 with 6 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "cg_posterior = az.extract(idata_cg)\n",
                "dist = pz.Normal(0, 1)\n",
                "comparisons = [\n",
                "    (categories[i], categories[j]) for i in range(4) for j in range(i + 1, 4)\n",
                "]\n",
                "\n",
                "_, axes2 = plt.subplots(3, 2, figsize=(12, 8), sharex=True)\n",
                "\n",
                "for (i, j), ax2 in zip(comparisons, axes2.ravel()):\n",
                "    means_diff = cg_posterior[\"μ\"].sel(days=i) - cg_posterior[\"μ\"].sel(days=j)\n",
                "\n",
                "    d_cohen = (\n",
                "        (\n",
                "            means_diff\n",
                "            / np.sqrt(\n",
                "                (\n",
                "                    cg_posterior[\"σ\"].sel(days=i) ** 2\n",
                "                    + cg_posterior[\"σ\"].sel(days=j) ** 2\n",
                "                )\n",
                "                / 2\n",
                "            )\n",
                "        )\n",
                "        .mean()\n",
                "        .item()\n",
                "    )\n",
                "\n",
                "    ps = dist.cdf(d_cohen / (2**0.5))\n",
                "    az.plot_posterior(means_diff.values, ref_val=0, ax=ax2)\n",
                "    ax2.set_title(f\"{i} - {j}\")\n",
                "    ax2.plot(0, label=f\"Cohen's d = {d_cohen:.2f}\\nProb sup = {ps:.2f}\", alpha=0)\n",
                "    ax2.legend(loc=1)\n",
                "\n",
                ""# plt.savefig(\"../images/bbap/bap-03-tips-post.png\")"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "88f4d5d5",
            "metadata": {},
            "source": [
                "## Sharing information, sharing priors"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 10,
            "id": "ROlb",
            "metadata": {},
            "outputs": [],
            "source": [
                "cs_data = pd.read_csv(\"../data/chemical_shifts_theo_exp.csv\")\n",
                "diff = cs_data.theo - cs_data.exp\n",
                "cat_encode = pd.Categorical(cs_data[\"aa\"])\n",
                "idx_chem = cat_encode.codes\n",
                "coords_chem = {\"aa\": cat_encode.categories}"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "20d015e1",
            "metadata": {},
            "source": [
                "### Code 3.1"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 11,
            "id": "TqIu",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_chem = \"../../book-prob-tmp/bap-03-chem-nh.nc\"\n",
                "\n",
                "with pm.Model(coords=coords_chem) as cs_nh:\n",
                "    μ_ = pm.Normal(\"μ\", mu=0, sigma=10, dims=\"aa\")\n",
                "    σ_ = pm.HalfNormal(\"σ\", sigma=10, dims=\"aa\")\n",
                "    y_ = pm.Normal(\"y\", mu=μ_[idx_chem], sigma=σ_[idx_chem], observed=diff)\n",
                "\n",
                "    if os.path.isfile(path_chem):\n",
                "        idata_cs_nh = az.from_netcdf(path_chem)\n",
                "    else:\n",
                "        idata_cs_nh = pm.sample(random_seed=4591)\n",
                "        idata_cs_nh.to_netcdf(path_chem)"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "65caf368",
            "metadata": {},
            "source": [
                "### Code 3.2"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 12,
            "id": "DnEU",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_chem_h = \"../../book-prob-tmp/bap-03-chem-h.nc\"\n",
                "\n",
                "with pm.Model(coords=coords_chem) as cs_h:\n",
                "    # hyper_priors\n",
                "    μ_mu = pm.Normal(\"μ_mu\", mu=0, sigma=10)\n",
                "    μ_sd = pm.HalfNormal(\"μ_sd\", 10)\n",
                "    # priors\n",
                "    _μ_ = pm.Normal(\"μ\", mu=μ_mu, sigma=μ_sd, dims=\"aa\")\n",
                "    _σ_ = pm.HalfNormal(\"σ\", sigma=10, dims=\"aa\")\n",
                "    # likelihood\n",
                "    pm.Normal(\"y\", mu=_μ_[idx_chem], sigma=_σ_[idx_chem], observed=diff)\n",
                "\n",
                "    if os.path.isfile(path_chem_h):\n",
                "        idata_cs_h = az.from_netcdf(path_chem_h)\n",
                "    else:\n",
                "        idata_cs_h = pm.sample(random_seed=4591)\n",
                "        idata_cs_h.to_netcdf(path_chem_h)"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "26a9ce81",
            "metadata": {},
            "source": [
                "### Figure 3.3"
            ]
