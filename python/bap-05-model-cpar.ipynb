            "source": [
                "import os\n",
                "\n",
                "import arviz as az\n",
                "import matplotlib.pyplot as plt\n",
                "import numpy as np\n",
                "import preliz as pz\n",
                "import pymc as pm\n",
                "from scipy import stats"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 2,
            "id": "vblA",
            "metadata": {},
            "outputs": [],
            "source": [
                "az.style.use(\"arviz-darkgrid\")"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "2f956cc9",
            "metadata": {},
            "source": [
                "# Model Comparison"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 3,
            "id": "bkHC",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "[Text(0.5, 0, 'x'), Text(0, 0.5, 'y')]"
                        ]
                    },
                    "execution_count": 3,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 720x480 with 1 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "dummy_data = np.loadtxt(\"../data/dummy.csv\")\n",
                "x = dummy_data[:, 0]\n",
                "y = dummy_data[:, 1]\n",
                "\n",
                "order = 2\n",
                "x_p = np.vstack([x**i for i in range(1, order + 1)])\n",
                "x_c = (x_p - x_p.mean(axis=1, keepdims=True)) / x_p.std(axis=1, keepdims=True)\n",
                "y_c = (y - y.mean()) / y.std()\n",
                "\n",
                "_, ax0 = plt.subplots()\n",
                "ax0.scatter(x_c[0], y_c)\n",
                "ax0.set(xlabel=\"x\", ylabel=\"y\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 4,
            "id": "lEQa",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_lr = \"../../book-prob-tmp/bap-05-linreg1.nc\"\n",
                "with pm.Model() as model_l:\n",
                "    α = pm.Normal(\"α\", mu=0, sigma=1)\n",
                "    β = pm.Normal(\"β\", mu=0, sigma=10)\n",
                "    ε = pm.HalfNormal(\"ϵ\", 5)\n",
                "    μ = α + β * x_c[0]\n",
                "    y_pred = pm.Normal(\"y_pred\", mu=μ, sigma=ε, observed=y_c)\n",
                "    if os.path.isfile(path_lr):\n",
                "        idata_l = az.from_netcdf(path_lr)\n",
                "    else:\n",
                "        idata_l = pm.sample(\n",
                "            2000, idata_kwargs={\"log_likelihood\": True}, random_seed=4591\n",
                "        )\n",
                "        idata_l.to_netcdf(path_lr)\n",
                "\n",
                "path_lrp = \"../../book-prob-tmp/bap-05-linreg-poly2.nc\"\n",
                "with pm.Model() as model_p:\n",
                "    α = pm.Normal(\"α\", mu=0, sigma=1)\n",
                "    β = pm.Normal(\"β\", mu=0, sigma=10, shape=order)\n",
                "    ε = pm.HalfNormal(\"ϵ\", 5)\n",
                "    μ = α + pm.math.dot(β, x_c)\n",
                "    y_pred = pm.Normal(\"y_pred\", mu=μ, sigma=ε, observed=y_c)\n",
                "    if os.path.isfile(path_lrp):\n",
                "        idata_q = az.from_netcdf(path_lrp)\n",
                "    else:\n",
                "        idata_q = pm.sample(\n",
                "            2000, idata_kwargs={\"log_likelihood\": True}, random_seed=4591\n",
                "        )\n",
                "        idata_q.to_netcdf(path_lrp)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 5,
            "id": "PKri",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "<matplotlib.legend.Legend at 0x176b96ab0>"
                        ]
                    },
                    "execution_count": 5,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 720x480 with 1 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "x_new = np.linspace(x_c[0].min(), x_c[0].max(), 100)\n",
                "\n",
                "posterior_l = az.extract(idata_l)\n",
                "posterior_p = az.extract(idata_q)\n",
                "α_l_post = posterior_l[\"α\"].mean().item()\n",
                "β_l_post = posterior_l[\"β\"].mean().item()\n",
                "y_l_post = α_l_post + β_l_post * x_new\n",
                "\n",
                "α_p_post = posterior_p[\"α\"].mean().item()\n",
                "β_p_post = posterior_p[\"β\"].mean(\"sample\")\n",
                "idx = np.argsort(x_c[0])\n",
                "y_p_post = α_p_post + np.dot(β_p_post, x_c)\n",
                "\n",
                "_, ax1 = plt.subplots()\n",
                "ax1.plot(x_new, y_l_post, \"C1\", label=\"linear model\")\n",
                "ax1.plot(x_c[0][idx], y_p_post[idx], \"C2\", label=f\"model order {order}\")\n",
                "ax1.scatter(x_c[0], y_c, c=\"C0\", marker=\".\")\n",
                "ax1.legend()"
            ]
        },
