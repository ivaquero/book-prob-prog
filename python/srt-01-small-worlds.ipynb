            "source": [
                "df5[\"prior\"] = np.where(\n",
                "    df5[\"row\"] == \"flat\",\n",
                "    1,\n",
                "    np.where(\n",
                "        df5[\"row\"] == \"stepped\",\n",
                "        np.repeat([0, 1], sequence_length / 2 * 3),\n",
                "        np.exp(-abs(df5[\"probability\"] - 0.5) / 0.25) / (2 * 0.25),\n",
                "    ),\n",
                ")\n",
                "\n",
                "df5[\"likelihood\"] = stats.binom.pmf(6, 9, df5[\"probability\"])\n",
                "df5"
            ]
        },
