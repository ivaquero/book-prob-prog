            ],
            "source": [
                "np.random.seed(42)\n",
                "\n",
                "y_l = pm.sample_posterior_predictive(\n",
                "    idata_l, model=model_l, extend_inferencedata=True\n",
                ").posterior_predictive[\"y_pred\"]\n",
                "y_p = pm.sample_posterior_predictive(\n",
                "    idata_q, model=model_p, extend_inferencedata=True\n",
                ").posterior_predictive[\"y_pred\"]"
            ]
        },
