            "source": [
                "## Multiple logistic regression"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 17,
            "id": "ulZA",
            "metadata": {},
            "outputs": [],
            "source": [
                "y_1 = pd.Categorical(iris2[\"species\"]).codes\n",
                "x_1 = iris2[[\"sepal_length\", \"sepal_width\"]].to_numpy()"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 18,
            "id": "ecfG",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_m = \"../../book-prob-tmp/bap-04-iris-logreg-multi.nc\"\n",
                "with pm.Model() as model_1:\n",
                "    α_lgm = pm.Normal(\"α\", mu=0, sigma=10)\n",
                "    β_lgm = pm.Normal(\"β\", mu=0, sigma=2, shape=2)\n",
                "    μ_lgm = α_lgm + pm.math.dot(x_1, β_lgm)\n",
                "    θ_lgm = pm.Deterministic(\"θ\", 1 / (1 + pm.math.exp(-μ_lgm)))\n",
                "    bd_lgm = pm.Deterministic(\"bd\", -α_lgm / β_lgm[1] - β_lgm[0] / β_lgm[1] * x_1[:, 0])\n",
                "    yl_lgm = pm.Bernoulli(\"yl\", p=θ_lgm, observed=y_1)\n",
                "    if os.path.isfile(path_m):\n",
                "        idata_m = az.from_netcdf(path_m)\n",
                "    else:\n",
                "        idata_m = pm.sample(random_seed=123, target_accept=0.9)\n",
                "        idata_m.to_netcdf(path_m)"
            ]
        },
