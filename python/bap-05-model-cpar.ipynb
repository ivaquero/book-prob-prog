            "source": [
                "with plt.rc_context({\"lines.linewidth\": 3}):\n",
                "    for a, b in priors_bf:\n",
                "        ax_bf = pz.Beta(a, b).plot_pdf()\n",
                "\n",
                "
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 23,
            "id": "pHFh",
            "metadata": {},
            "outputs": [],
            "source": [
                "coins = 30\n",
                "heads = 9\n",
                "y_d = np.repeat([0, 1], [coins - heads, heads])"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 24,
            "id": "NCOB",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_bf = \"../../book-prob-tmp/bap-05-bf.nc\"\n",
                "with pm.Model() as model_BF:\n",
                "    p_1 = np.array([0.5, 0.5])\n",
                "    model_index = pm.Categorical(\"model_index\", p=p_1)\n",
                "    m_0 = (4, 8)\n",
                "    m_1 = (8, 4)\n",
                "    m = pm.math.switch(pm.math.eq(model_index, 0), m_0, m_1)\n",
                "    θ_bf = pm.Beta(\"θ\", m[0], m[1])\n",
                "    y_bf = pm.Bernoulli(\"y\", θ_bf, observed=y_d)\n",
                "    if os.path.isfile(path_bf):\n",
                "        idata_BF = az.from_netcdf(path_bf)\n",
                "    else:\n",
                "        idata_BF = pm.sample(random_seed=123)\n",
                "        idata_BF.to_netcdf(path_bf)"
            ]
        },
