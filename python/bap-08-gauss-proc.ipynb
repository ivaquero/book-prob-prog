            "source": [
                "years = int((coal_df.max() - coal_df.min()).to_numpy().flatten()[0])\n",
                "bins = years // 4\n",
                "hist, x_edges = np.histogram(coal_df, bins=bins)\n",
                "x_centers = x_edges[:-1] + (x_edges[1] - x_edges[0]) / 2\n",
