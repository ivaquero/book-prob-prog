                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "np.random.seed(42)\n",
                "_, ax = plt.subplots()\n",
                "x = np.linspace(0, 1, 10)\n",
                "y = np.random.normal(0, 1, len(x))\n",
                "ax.plot(x, y, \"o-\", label=\"the first one\")\n",
                "y = np.zeros_like(x)\n",
                "for i in range(len(x)):\n",
                "    y[i] = np.random.normal(y[i - 1], 1)\n",
                "ax.plot(x, y, \"o-\", label=\"the second one\")\n",
                "ax.legend()"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 4,
            "id": "PKri",
            "metadata": {},
            "outputs": [],
            "source": [
                "def exp_quad_kernel(x, knots, ℓ=1):\n",
                "    return np.array([np.exp(-((x - k) ** 2) / (2 * ℓ**2)) for k in knots])"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 5,
            "id": "Xref",
            "metadata": {},
            "outputs": [],
            "source": [
                "#  def linear_kernel(x, knots):\n",
                "#      \"\"\" linear kernel \"\"\"\n",
                "#     return np.array([(x - 2) * (k - 2) for k in knots])"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 6,
            "id": "SFPL",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 1200x500 with 2 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "data = np.array([-1, 0, 1, 2])\n",
                "cov_q = exp_quad_kernel(data, data, 1)\n",
                "_, ax1 = plt.subplots(1, 2, figsize=(12, 5))\n",
                "ax_co = np.ravel(ax1)\n",
                "ax_co[0].plot(data, np.zeros_like(data), \"ko\")\n",
                "ax_co[0].set(yticks=[])\n",
                "for idx, i_data in enumerate(data):\n",
                "    ax_co[0].text(i_data, 0 + 0.005, idx)\n",
                "ax_co[0].set_xticks(data)\n",
                "ax_co[0].set_xticklabels(np.round(data, 2))\n",
                "ax_co[1].grid(False)\n",
                "im = ax1[1].imshow(cov_q)\n",
                "colors = [\"w\", \"k\"]\n",
                "for _i in range(len(cov_q)):\n",
                "    for _j in range(len(cov_q)):\n",
                "        ax_co[1].text(\n",
                "            _j,\n",
                "            _i,\n",
                "            round(cov_q[_i, _j], 2),\n",
                "            color=colors[int(im.norm(cov_q[_i, _j]) > 0.5)],\n",
                "            ha=\"center\",\n",
                "            va=\"center\",\n",
                "            fontdict={\"size\": 16},\n",
                "        )\n",
                "ax_co[1].set(xticks=range(len(data)), yticks=range(len(data)))\n",
                "ax_co[1].xaxis.tick_top()\n",
                "\n",
                "
            ]
        },
        {
            "cell_type": "code",
