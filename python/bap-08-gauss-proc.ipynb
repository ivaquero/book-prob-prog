                "bins_1 = 20\n",
                "hist_1, x1_edges, x2_edges = np.histogram2d(\n",
                "    rw_df.latitude.to_numpy().flatten(),\n",
                "    rw_df.longitude.to_numpy().flatten(),\n",
                "    bins=bins_1,\n",
                ")\n",
                "x1_centers = x1_edges[:-1] + (x1_edges[1] - x1_edges[0]) / 2\n",
