                    "output_type": "display_data"
                },
                {
                    "name": "stderr",
                    "output_type": "stream",
                    "text": [
                        "Sampling 4 chains for 1_000 tune and 1_000 draw iterations (4_000 + 4_000 draws total) took 1 seconds.\n"
                    ]
                }
            ],
            "source": [
                "with pm.Model() as ZIP:\n",
                "    ψ_z = pm.Beta(\"ψ\", 1, 1)\n",
                "    θ_z = pm.Gamma(\"θ\", 2, 0.1)\n",
                "    y_z = pm.ZeroInflatedPoisson(\"y\", ψ_z, θ_z, observed=counts)\n",
                "\n",
                "    idata_z = pm.sample(random_seed=123)"
            ]
        },
