                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "np.random.seed(42)\n",
                "x_2 = np.random.uniform(0, 10, size=15)\n",
                "y_1 = np.random.normal(np.sin(x_2), 0.1)\n",
                "true_x = np.linspace(0, 10, 200)\n",
                "_, ax2 = plt.subplots()\n",
                "ax2.plot(x_2, y_1, \"o\")\n",
                "ax2.plot(true_x, np.sin(true_x), \"k--\")\n",
                "ax2.set(xlabel=\"x\", ylabel=\"f(x)\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 9,
            "id": "emfo",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_gpreg = \"../../book-prob-tmp/bap-08-gpreg.nc\"\n",
                "X = x_2[:, None]\n",
                "with pm.Model() as model_reg:\n",
                "    ll_gp = pm.Gamma(\"ℓ\", 2, 0.5)\n",
                "    cov_gp = pm.gp.cov.ExpQuad(1, ls=ll_gp)\n",
                "    gp = pm.gp.Marginal(cov_func=cov_gp)\n",
                "    ε_gp = pm.HalfNormal(\"ϵ\", 25)\n",
                "    y_pred = gp.marginal_likelihood(\"y_pred\", X=X, y=y_1, sigma=ε_gp)\n",
                "    if os.path.isfile(path_gpreg):\n",
                "        idata_reg = az.from_netcdf(path_gpreg)\n",
                "    else:\n",
                "        idata_reg = pm.sample(2000, return_inferencedata=True)\n",
                "        idata_reg.to_netcdf(path_gpreg)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 10,
            "id": "Hstk",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "array([[<Axes: title={'center': 'ℓ'}>, <Axes: title={'center': 'ℓ'}>],\n",
                            "       [<Axes: title={'center': 'ϵ'}>, <Axes: title={'center': 'ϵ'}>]],\n",
                            "      dtype=object)"
                        ]
                    },
                    "execution_count": 10,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 1200x400 with 4 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "az.plot_trace(idata_reg, compact=False)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "nWHF",
            "metadata": {},
            "outputs": [],
            "source": [
                "X_new = np.linspace(np.floor(x_2.min()), np.ceil(x_2.max()), 100)[:, None]\n",
                "with model_reg:\n",
                "    del model_reg.named_vars[\"f_pred\"]\n",
                "    f_pred = gp.conditional(\"f_pred\", X_new)\n",
                "    pred_samples = pm.sample_posterior_predictive(idata_reg, var_names=[f_pred])"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "iLit",
            "metadata": {},
            "outputs": [],
            "source": [
                "_, ax3 = plt.subplots(figsize=(12, 5))\n",
                "pm.gp.util.plot_gp_dist(\n",
                "    ax3, pred_samples[\"f_pred\"], X_new, palette=\"viridis\", plot_samples=False\n",
                ")\n",
                "ax3.plot(X, y_1, \"ko\")\n",
                "ax3.set(xlabel=\"x\", ylabel=\"f(x)\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "ZHCJ",
            "metadata": {},
            "outputs": [],
            "source": [
                "X_new_1 = np.linspace(np.floor(x_2.min()), np.ceil(x_2.max()), 100)[:, None]\n",
                "with model_reg:\n",
                "    point = {\n",
                "        \"ℓ\": idata_reg.posterior[\"ℓ\"].mean((\"chain\", \"draw\")).to_numpy().flatten(),\n",
                "        \"ϵ\": idata_reg.posterior[\"ϵ\"].mean((\"chain\", \"draw\")).to_numpy().flatten(),\n",
                "    }\n",
                "    μ, var = gp.predict(X_new_1, point=point, diag=True)\n",
                "    sd = var**0.5"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "ROlb",
            "metadata": {},
            "outputs": [],
            "source": [
                "_, ax4 = plt.subplots(figsize=(12, 5))\n",
                "ax4.plot(X_new_1, μ, \"C1\")\n",
                "ax4.fill_between(X_new_1.flatten(), μ - sd, μ + sd, color=\"C1\", alpha=0.3)\n",
                "ax4.fill_between(X_new_1.flatten(), μ - 2 * sd, μ + 2 * sd, color=\"C1\", alpha=0.3)\n",
                "ax4.plot(X, y_1, \"ko\")\n",
                "ax4.set(xlabel=\"X\")"
            ]
        },
