            "source": [
                "np.random.seed(24)\n",
                "points = np.linspace(0, 10, 200)\n",
                "fig, axes = plt.subplots(\n",
                "    2, 2, figsize=(12, 6), sharex=True, sharey=True, constrained_layout=True\n",
                ")\n",
                "for ll, ax_co2 in zip((0.2, 1, 2, 10), axes.flatten()):\n",
                "    cov_q2 = exp_quad_kernel(points, points, ll)\n",
                "    ax_co2.plot(points, stats.multivariate_normal.rvs(cov=cov_q2, size=2).T)\n",
                "    ax_co2.set(title=f\"ℓ ={ll}\")\n",
                "fig.text(0.51, -0.03, \"x\", fontsize=\"medium\")\n",
                "fig.text(-0.03, 0.5, \"f(x)\", fontsize=\"medium\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 8,
            "id": "Kclp",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "[Text(0.5, 0, 'x'), Text(0, 0.5, 'f(x)')]"
                        ]
                    },
                    "execution_count": 8,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 720x480 with 1 Axes>"
