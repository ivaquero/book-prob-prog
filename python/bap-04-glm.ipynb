            "source": [
                "iris_df = iris.query(\"species == ('setosa', 'versicolor')\")[45:]\n",
                "y_3 = pd.Categorical(iris_df[\"species\"]).codes\n",
                "x_3 = iris_df[[\"sepal_length\", \"sepal_width\"]].to_numpy()"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 28,
            "id": "TXez",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_ub = \"../../book-prob-tmp/bap-04-iris-unbalanced.nc\"\n",
                "with pm.Model() as model_ub:\n",
                "    α_ub = pm.Normal(\"α\", mu=0, sigma=10)\n",
                "    β_ub = pm.Normal(\"β\", mu=0, sigma=2, shape=2)\n",
                "    μ_ub = α_ub + pm.math.dot(x_3, β_ub)\n",
                "    θ_ub = 1 / (1 + pm.math.exp(-μ_ub))\n",
                "    bd_ub = pm.Deterministic(\"bd\", -α_ub / β_ub[1] - β_ub[0] / β_ub[1] * x_3[:, 0])\n",
                "    yl_ub = pm.Bernoulli(\"yl\", p=θ_ub, observed=y_3)\n",
                "    if os.path.isfile(path_ub):\n",
                "        idata_ub = az.from_netcdf(path_ub)\n",
                "    else:\n",
                "        idata_ub = pm.sample(random_seed=123)\n",
                "        idata_ub.to_netcdf(path_ub)"
            ]
        },
