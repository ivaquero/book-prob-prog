            "metadata": {},
            "outputs": [],
            "source": [
                "path_coal = \"../../book-prob-tmp/bap-08-cp-coal.nc\"\n",
                "with pm.Model() as model_coal:\n",
                "    ll_coal = pm.HalfNormal(\"ℓ\", x_data_1.std())\n",
                "    cov_coal = pm.gp.cov.ExpQuad(1, ls=ll_coal) + pm.gp.cov.WhiteNoise(1e-05)\n",
                "    gp_coal = pm.gp.Latent(cov_func=cov_coal)\n",
                "    f_coal = gp_coal.prior(\"f\", X=x_data_1)\n",
                "    _ = pm.Poisson(\"y_pred\", mu=pm.math.exp(f_coal), observed=y_data)\n",
                "    if os.path.isfile(path_coal):\n",
                "        idata_coal = az.from_netcdf(path_coal)\n",
                "    else:\n",
                "        idata_coal = pm.sample(1000, chains=1)\n",
                "        idata_coal.to_netcdf(path_coal)"
