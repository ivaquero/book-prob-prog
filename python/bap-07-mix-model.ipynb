                "K_2 = 20\n",
                "\n",
                "\n",
                "def stick_breaking(α, K):\n",
                "    β = pm.Beta(\"β\", 1.0, α, shape=K)\n",
                "    return β * pm.math.concatenate([[1.0], tt.extra_ops.cumprod(1.0 - β)[:-1]])\n",
                "\n",
                "\n",
                "path_stick = \"../../book-prob-tmp/bap-07-stick-break.nc\"\n",
                "with pm.Model() as model_stick:\n",
                "    α = pm.Gamma(\"α\", 1, 1.0)\n",
                "    w = pm.Deterministic(\"w\", stick_breaking(α, K_2))\n",
                "    _means = pm.Normal(\n",
                "        \"means\",\n",
                "        mu=np.linspace(cs[\"exp\"].min(), cs[\"exp\"].max(), K_2),\n",
                "        sigma=10,\n",
                "        shape=K_2,\n",
                "    )\n",
                "    sd_nf = pm.HalfNormal(\"sd\", sigma=10, shape=K_2)\n",
                "    obs_nf = pm.NormalMixture(\n",
                "        \"obs\", w, means, sigma=sd_nf, observed=cs[\"exp\"].to_numpy()\n",
                "    )\n",
                "    if os.path.isfile(path_stick):\n",
                "        idata_g = az.from_netcdf(path_stick)\n",
                "    else:\n",
                "        idata_g = pm.sample(1000, tune=2000, nuts={\"target_accept\": 0.9})\n",
                "        idata_g.to_netcdf(path_stick)"
            ]
        },
