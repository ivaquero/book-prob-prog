            "source": [
                "y_dbf = np.repeat([1, 0], [50, 50])  # 50 heads, 50 tails\n",
                "priors_bf = ((1, 1), (30, 30))  # uniform prior, peaked prior"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 22,
            "id": "AjVT",
            "metadata": {},
            "outputs": [
                {
                    "data": {
