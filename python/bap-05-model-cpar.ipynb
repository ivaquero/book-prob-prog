            ],
            "source": [
                "x_ = np.array([6.5, 10])\n",
                "y_ = np.array([7, 10])\n",
                "x1 = np.concatenate((x0, x_))\n",
                "y1 = np.concatenate((y0, y_))\n",
                "\n",
                "_, ax3_ = plt.subplots(figsize=(12, 4))\n",
                "ax3_.plot(x0, y0, \"ko\", zorder=3)\n",
                "ax3_.plot(x_, y_, \"ks\", zorder=3)\n",
                "ax3_.set(xticks=[], yticks=[])\n",
                "\n",
                "for idx2, order_2 in enumerate(orders):\n",
                "    yhat2 = ps[idx2](x1)\n",
                "    ybar2 = np.mean(y1)\n",
                "    ss_reg2 = np.sum((yhat2 - y1) ** 2)\n",
                "    ss_total2 = np.sum((ybar2 - y1) ** 2)\n",
                "    r22 = 1 - ss_reg2 / ss_total2\n",
                "    ax3_.plot(x_n, ps[idx2](x_n), label=f\"order {order_2}, $R^2$= {r22:.3f}\")\n",
                "\n",
                "ax3_.legend(loc=2, fontsize=12)"
            ]
        },
