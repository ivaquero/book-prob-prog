        {
            "cell_type": "markdown",
            "id": "26a8a902",
            "metadata": {},
            "source": [
                "## Occam's razor"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 11,
            "id": "nWHF",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "<matplotlib.legend.Legend at 0x179feef90>"
                        ]
                    },
                    "execution_count": 11,
                    "metadata": {},
                    "output_type": "execute_result"
                },
                {
                    "data": {
                        "image/png": "",
                        "text/plain": [
                            "<Figure size 1200x400 with 1 Axes>"
                        ]
                    },
                    "metadata": {},
                    "output_type": "display_data"
                }
            ],
            "source": [
                "x0 = np.array([4.0, 5.0, 6.0, 9.0, 12, 14.0])\n",
                "y0 = np.array([4.2, 6.1, 5.0, 10.0, 10, 14.0])\n",
                "orders = [0, 1, 5]\n",
                "x_n = np.linspace(x0.min(), x0.max(), 100)\n",
                "ps = []\n",
                "\n",
                "_, ax3 = plt.subplots(figsize=(12, 4))\n",
                "ax3.plot(x0, y0, \"ko\", zorder=3)\n",
                "ax3.set(xticks=[], yticks=[])\n",
                "\n",
                "for order_ in orders:\n",
                "    p = np.polynomial.Polynomial.fit(x0, y0, deg=order_)\n",
                "    ps.append(p)\n",
                "    yhat = p(x0)\n",
                "    ybar = np.mean(y0)\n",
                "    ss_reg = np.sum((yhat - y0) ** 2)\n",
                "    ss_total = np.sum((ybar - y0) ** 2)\n",
                "    r2 = 1 - ss_reg / ss_total\n",
                "    ax3.plot(x_n, p(x_n), label=f\"order {order_}, $R^2$= {r2:.3f}\")\n",
                "\n",
                "ax3.legend(loc=2)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 12,
            "id": "iLit",
            "metadata": {},
            "outputs": [
                {
                    "data": {
                        "text/plain": [
                            "<matplotlib.legend.Legend at 0x3003825d0>"
