            "source": [
                "path_island = \"../../book-prob-tmp/bap-08-island.nc\"\n",
                "with pm.Model() as model_islands:\n",
                "    η = pm.HalfCauchy(\"η\", 1)\n",
                "    ll_sa = pm.HalfCauchy(\"ℓ\", 1)\n",
                "    cov_sa = η * pm.gp.cov.ExpQuad(1, ls=ll_sa)\n",
                "    gp_sa = pm.gp.Latent(cov_func=cov_sa)\n",
                "    f_sa = gp_sa.prior(\"f\", X=islands_dist_sqr)\n",
                "    α = pm.Normal(\"α\", 0, 10)\n",
                "    β = pm.Normal(\"β\", 0, 1)\n",
                "    μ_1 = pm.math.exp(α + f_sa[index] + β * logpop)\n",
                "    tt_pred = pm.Poisson(\"tt_pred\", μ_1, observed=total_tools)\n",
                "    if os.path.isfile(path_island):\n",
                "        idata_islands = az.from_netcdf(path_island)\n",
                "    else:\n",
                "        idata_islands = pm.sample(1000, tune=1000)\n",
                "        idata_islands.to_netcdf(path_island)"
            ]
        },
