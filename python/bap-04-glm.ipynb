                "children = [0, 1, 2, 3, 4]\n",
                "fish_count_pred_0 = []\n",
                "fish_count_pred_1 = []\n",
                "posterior_zr = idata_zr.posterior.stack(samples=(\"chain\", \"draw\"))\n",
                "α_m = posterior_zr[\"α\"]\n",
                "β1_m = posterior_zr[\"β\"].to_numpy()[0]\n",
                "β2_m = posterior_zr[\"β\"].to_numpy()[1]\n",
                "\n",
                "for _n in children:\n",
                "    without_camper = α_m + β1_m * n\n",
                "    with_camper = without_camper + β2_m\n",
                "    fish_count_pred_0.append(np.exp(without_camper))\n",
                "    fish_count_pred_1.append(np.exp(with_camper))\n",
                "\n",
                "_, ax7 = plt.subplots()\n",
                "ax7.plot(children, fish_count_pred_0, \"C0.\", alpha=0.01)\n",
                "ax7.plot(children, fish_count_pred_1, \"C1.\", alpha=0.01)\n",
                "ax7.set(xlabel=\"number of children\", ylabel=\"fish caught\", xticks=children)\n",
                "ax7.plot([], \"C0o\", label=\"without camper\")\n",
                "ax7.plot([], \"C1o\", label=\"with camper\")\n",
                "ax7.legend(loc=\"upper right\")\n",
                "# plt.savefig(\"../images/bbap/bap-04-fish-zipreg.png\")"
