                            "1           4.9          3.0           1.4          0.2  setosa\n",
                            "2           4.7          3.2           1.3          0.2  setosa\n",
                            "3           4.6          3.1           1.5          0.2  setosa\n",
                            "4           5.0          3.6           1.4          0.2  setosa"
                        ]
                    },
                    "execution_count": 23,
                    "metadata": {},
                    "output_type": "execute_result"
                }
            ],
            "source": [
                "iris = pd.read_csv(\"../data/iris.csv\")\n",
                "iris.head()"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 24,
            "id": "AjVT",
            "metadata": {},
            "outputs": [],
            "source": [
                "iris_1 = iris.query(\"species == ('setosa', 'versicolor')\")\n",
                "y_2 = pd.Categorical(iris_1[\"species\"]).codes\n",
                "x_1 = iris_1[\"sepal_length\"].to_numpy().flatten()\n",
                "X_1 = x_1[:, None]"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 25,
            "id": "pHFh",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_gpcls = \"../../book-prob-tmp/bap-08-gpcls-iris.nc\"\n",
                "with pm.Model() as model_iris:\n",
                "    ll_gpc = pm.Gamma(\"ℓ\", 2, 0.5)\n",
                "    cov_gpc = pm.gp.cov.ExpQuad(1, ll_gpc)\n",
                "    gp_c = pm.gp.Latent(cov_func=cov_gpc)\n",
                "    f_gpc = gp_c.prior(\"f\", X=X_1)\n",
                "    _ = pm.Bernoulli(\"y\", p=pm.math.sigmoid(f_gpc), observed=y_2)\n",
                "    if os.path.isfile(path_gpcls):\n",
                "        idata_iris = az.from_netcdf(path_gpcls)\n",
                "    else:\n",
                "        idata_iris = pm.sample(1000, chains=1, compute_convergence_checks=False)\n",
                "        idata_iris.to_netcdf(path_gpcls)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "NCOB",
            "metadata": {},
            "outputs": [],
            "source": [
                "X_new_2 = np.linspace(np.floor(x_1.min()), np.ceil(x_1.max()), 200)[:, None]\n",
                "with model_iris:\n",
                "    # del model_iris.named_vars[\"f_pred\"]\n",
                "    f_pred_c = gp_c.conditional(\"f_pred\", X_new_2)\n",
                "    pred_samples_c = pm.sample_posterior_predictive(idata_iris, var_names=[f_pred_c])"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 27,
            "id": "aqbW",
            "metadata": {},
            "outputs": [],
            "source": [
                "def find_midpoint(array1, array2, value):\n",
                "    array1 = np.asarray(array1)\n",
                "    idx0 = np.argsort(np.abs(array1 - value))[0]\n",
                "    idx1 = idx0 - 1 if array1[idx0] > value else idx0 + 1\n",
                "    if idx1 == len(array1):\n",
                "        idx1 = idx1 - 1\n",
                "    return (array2[idx0] + array2[idx1]) / 2"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "TRpd",
            "metadata": {},
            "outputs": [],
            "source": [
                "_, ax7 = plt.subplots(figsize=(10, 6))\n",
                "fp = logistic(pred_samples[\"f_pred\"])\n",
                "fp_mean = np.mean(fp, 0)\n",
                "ax7.plot(X_new_2[:, 0], fp_mean)\n",
                "ax7.scatter(x_1, np.random.normal(y_2, 0.02), marker=\".\", color=[f\"C{x}\" for x in y_2])\n",
                "az.plot_hdi(X_new_2[:, 0], fp, color=\"C2\")\n",
                "db_lg = np.array([find_midpoint(f, X_new_2[:, 0], 0.5) for f in fp])\n",
                "db_lg_mean = db_lg.mean()\n",
                "db_lg_hpd = az.hpd(db_lg)\n",
                "ax7.vlines(db_lg_mean, 0, 1, color=\"k\")\n",
                "ax7.fill_betweenx([0, 1], db_lg_hpd[0], db_lg_hpd[1], color=\"k\", alpha=0.5)\n",
                "ax7.set_xlabel(\"sepal_length\")\n",
                "ax7.set_ylabel(\"θ\", rotation=0)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 29,
            "id": "TXez",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_iris2 = \"../../book-prob-tmp/bap-08-gpcls-iris2.nc\"\n",
                "with pm.Model() as model_iris2:\n",
                "    ll_gpc2 = pm.Gamma(\"ℓ\", 2, 0.5)\n",
                "    c = pm.Normal(\"c\", x_1.min())\n",
                "    τ = pm.HalfNormal(\"τ\", 5)\n",
                "    cov_gpc2 = (\n",
                "        pm.gp.cov.ExpQuad(1, ll_gpc2)\n",
                "        + τ * pm.gp.cov.Linear(1, c)\n",
                "        + pm.gp.cov.WhiteNoise(1e-05)\n",
                "    )\n",
                "    gp_3 = pm.gp.Latent(cov_func=cov_gpc2)\n",
                "    f_gpc2 = gp_3.prior(\"f\", X=X_1)\n",
                "    pm.Bernoulli(\"y\", p=pm.math.sigmoid(f_gpc2), observed=y_2)\n",
                "    if os.path.isfile(path_iris2):\n",
                "        idata_iris2 = az.from_netcdf(path_iris2)\n",
                "    else:\n",
                "        idata_iris2 = pm.sample(1000, chains=1, compute_convergence_checks=False)\n",
                "        idata_iris2.to_netcdf(path_iris2)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "id": "dNNg",
            "metadata": {},
            "outputs": [],
            "source": [
                "with model_iris2:\n",
                "    _f_pred = gp_3.conditional(\"f_pred\", X_new_2)\n",
                "    pred_samples_2 = pm.sample_posterior_predictive(idata_iris2, var_names=[f_pred])"
            ]
        },
