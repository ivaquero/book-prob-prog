            "id": "wAgl",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_flu = \"../../book-prob-tmp/bap-08-gpcls-flu.nc\"\n",
                "with pm.Model() as model_space_flu:\n",
                "    ll_fl = pm.HalfCauchy(\"ℓ\", 1)\n",
                "    cov_fl = pm.gp.cov.ExpQuad(1, ll_fl) + pm.gp.cov.WhiteNoise(1e-05)\n",
                "    gp_4 = pm.gp.Latent(cov_func=cov_fl)\n",
                "    f_fl = gp_4.prior(\"f\", X=age)\n",
                "    pm.Bernoulli(\"y\", p=pm.math.sigmoid(f_fl), observed=space_flu)\n",
                "    if os.path.isfile(path_flu):\n",
                "        idata_space_flu = az.from_netcdf(path_flu)\n",
                "    else:\n",
                "        idata_space_flu = pm.sample(1000, chains=1, compute_convergence_checks=False)\n",
                "        idata_space_flu.to_netcdf(path_flu)"
            ]
        },
        {
            "cell_type": "code",
