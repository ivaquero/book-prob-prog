            "source": [
                "from itertools import product\n",
                "\n",
                "\n",
                "def heatmap(data, iter_feature):\n",
                "    feats = data[iter_feature].unique()\n",
                "    colors = [f\"C{i}\" for i, _ in enumerate(feats)]\n",
                "    cols = data.drop(iter_feature, axis=1).columns\n",
                "    num_cols = len(cols)\n",
                "    pairs = [*product(cols, repeat=2)]\n",
                "\n",
                "    _, axes = plt.subplots(num_cols, num_cols, figsize=(10, 8))\n",
                "    axes = axes.flatten()\n",
                "\n",
                "    for color, ft in zip(colors, feats):\n",
                "        data_select = data.query(f\"{iter_feature} == '{ft}'\").drop(iter_feature, axis=1)\n",
                "        for ind, pair in enumerate(pairs):\n",
                "            ax = axes[ind]\n",
                "\n",
                "            if len(set(pair)) == 1:\n",
                "                ax.hist(\n",
                "                    data_select[pair[0]],\n",
                "                    bins=15,\n",
                "                    color=color,\n",
                "                    edgecolor=\"black\",\n",
                "                    alpha=0.5,\n",
                "                )\n",
                "            else:\n",
                "                ax.scatter(\n",
                "                    data_select[pair[0]],\n",
                "                    data_select[pair[1]],\n",
                "                    alpha=0.7,\n",
                "                    s=10,\n",
                "                    color=color,\n",
                "                )\n",
                "\n",
                "            if ind % num_cols == 0:\n",
                "                ax.set_ylabel(cols[int(ind / 4)], fontsize=10)\n",
                "            if ind > num_cols * (num_cols - 1) - 1:\n",
                "                ax.set_xlabel(cols[ind % num_cols], fontsize=10)\n",
                "\n",
                "\n",
                "heatmap(iris, \"species\")"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "f580b5f1",
            "metadata": {},
            "source": [
                "### The logistic model applied to the iris dataset"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 7,
            "id": "RGSE",
            "metadata": {},
            "outputs": [],
            "source": [
                "iris2 = iris.query(\"species == ('setosa', 'versicolor')\")\n",
                "y_0 = pd.Categorical(iris2[\"species\"]).codes\n",
                "x_0 = iris2[\"sepal_length\"].to_numpy()\n",
                "x_c = x_0 - x_0.mean()"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 8,
            "id": "Kclp",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_logreg = \"../../book-prob-tmp/bap-04-iris-logreg.nc\"\n",
                "with pm.Model() as model_lg:\n",
                "    α_lr = pm.Normal(\"α\", mu=0, sigma=1)\n",
                "    β_lr = pm.Normal(\"β\", mu=0, sigma=5)\n",
                "    μ_lr = α_lr + x_c * β_lr\n",
                "    θ_lr = pm.Deterministic(\"θ\", pm.math.sigmoid(μ_lr))\n",
                "    bd = pm.Deterministic(\"bd\", -α_lr / β_lr)\n",
                "    yl = pm.Bernoulli(\"yl\", p=θ_lr, observed=y_0)\n",
                "\n",
                "    if os.path.isfile(path_logreg):\n",
                "        idata_lg = az.from_netcdf(path_logreg)\n",
                "    else:\n",
                "        idata_lg = pm.sample(random_seed=123)\n",
                "        idata_lg.to_netcdf(path_logreg)"
            ]
        },
