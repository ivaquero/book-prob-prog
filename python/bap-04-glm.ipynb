            "source": [
                "## Softmax regression"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 30,
            "id": "wlCL",
            "metadata": {},
            "outputs": [],
            "source": [
                "y_s = pd.Categorical(iris[\"species\"]).codes\n",
                "x_s = iris[iris.columns[:-1]].to_numpy()\n",
                "x_s = (x_s - x_s.mean(axis=0)) / x_s.std(axis=0)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 31,
            "id": "kqZH",
            "metadata": {},
            "outputs": [],
            "source": [
                "path_sf = \"../../book-prob-tmp/bap-04-iris-softmax.nc\"\n",
                "with pm.Model() as model_s:\n",
                "    α_sf = pm.Normal(\"α\", mu=0, sigma=5, shape=3)\n",
                "    β_sf = pm.Normal(\"β\", mu=0, sigma=5, shape=(4, 3))\n",
                "    μ_sf = pm.Deterministic(\"μ\", α_sf + pm.math.dot(x_s, β_sf))\n",
                "    θ_sf = pm.math.softmax(μ_sf, axis=1)\n",
                "    yl_sf = pm.Categorical(\"yl\", p=θ_sf, observed=y_s)\n",
                "    if os.path.isfile(path_sf):\n",
                "        idata_s = az.from_netcdf(path_sf)\n",
                "    else:\n",
                "        idata_s = pm.sample(random_seed=123)\n",
                "        idata_s.to_netcdf(path_sf)"
            ]
        },
