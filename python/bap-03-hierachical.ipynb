            "source": [
                "axesh = az.plot_forest(\n",
                "    [idata_cs_nh, idata_cs_h],\n",
                "    model_names=[\"non_hierarchical\", \"hierarchical\"],\n",
                "    var_names=\"μ\",\n",
                "    combined=True,\n",
                "    r_hat=False,\n",
                "    ess=False,\n",
                "    figsize=(8, 6),\n",
                "    colors=\"cycle\",\n",
                ")\n",
                "y_lims = axesh[0].get_ylim()\n",
                "axesh[0].vlines(idata_cs_h.posterior[\"μ_mu\"].mean(), *y_lims, color=\"k\", ls=\":\")\n",
                "# plt.savefig(\"../images/bbap/bap-03-chem-forest.png\")"
            ]
        },
