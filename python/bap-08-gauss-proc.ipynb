                "db_mid = np.array([find_midpoint(f, X_new_2[:, 0], 0.5) for f in fp2])\n",
                "db_mid_mean = db_mid.mean()\n",
                "db_mid_hpd = az.hpd(db_mid)\n",
                "ax8.vlines(db_mid_mean, 0, 1, color=\"k\")\n",
                "ax8.fill_betweenx([0, 1], db_mid_hpd[0], db_mid_hpd[1], color=\"k\", alpha=0.5)\n",
