            "source": [
                "age = df_sf.age.to_numpy().flatten()[:, None]\n",
                "space_flu = df_sf.space_flu\n",
                "ax_flu = df_sf.plot.scatter(\"age\", \"space_flu\", figsize=(8, 5))\n",
                "ax_flu.set(yticks=[0, 1], yticklabels=[\"healthy\", \"sick\"])"
