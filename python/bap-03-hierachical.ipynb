        {
            "cell_type": "markdown",
            "id": "040dc44d",
            "metadata": {},
            "source": [
                "### Code 2.25"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 6,
            "id": "BYtC",
            "metadata": {},
            "outputs": [],
            "source": [
                "categories = np.array([\"Thur\", \"Fri\", \"Sat\", \"Sun\"])\n",
                "tip = tips[\"tip\"].to_numpy()\n",
                "idx = pd.Categorical(tips[\"day\"], categories=categories).codes"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "21351ffe",
            "metadata": {},
            "source": [
                "### Code 2.27"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 7,
            "id": "Kclp",
            "metadata": {},
            "outputs": [],
            "source": [
                "path = \"../../book-prob-tmp/bap-03-tips.nc\"\n",
                "\n",
                "coords = {\"days\": categories, \"days_flat\": categories[idx]}\n",
                "with pm.Model(coords=coords) as comparing_groups:\n",
                "    μ = pm.HalfNormal(\"μ\", sigma=5, dims=\"days\")\n",
                "    σ = pm.HalfNormal(\"σ\", sigma=1, dims=\"days\")\n",
                "    y = pm.Gamma(\"y\", mu=μ[idx], sigma=σ[idx], observed=tip, dims=\"days_flat\")\n",
                "\n",
                "    if os.path.isfile(path):\n",
                "        idata_cg = az.from_netcdf(path)\n",
                "    else:\n",
                "        idata_cg = pm.sample(random_seed=4591)\n",
                "        idata_cg.extend(pm.sample_posterior_predictive(idata_cg, random_seed=4591))\n",
                "        idata_cg.to_netcdf(path)"
            ]
        },
        {
            "cell_type": "markdown",
            "id": "b12d910b",
            "metadata": {},
            "source": [
                "### Code 2.28"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 8,
            "id": "Hstk",
            "metadata": {},
            "outputs": [
                {
                    "data": {
